{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "url",
          "priority",
          "kind",
          "topics",
          "methods",
          "entryUrl",
          "status",
          "checkedAt",
          "lastSuccessAt",
          "lastFailure",
          "canVerifyOfficial",
          "observation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "priority": {
            "enum": [
              "P0",
              "P1"
            ]
          },
          "kind": {
            "enum": [
              "official",
              "aggregator",
              "community",
              "price-reference"
            ]
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "ai-api",
                "ai-coding",
                "developer-tools",
                "gpu",
                "vps",
                "developer-benefits"
              ]
            }
          },
          "methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "html",
                "rss",
                "atom",
                "json",
                "github"
              ]
            }
          },
          "entryUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "status": {
            "enum": [
              "readable",
              "restricted",
              "unavailable",
              "unverified"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSuccessAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastFailure": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "at",
                  "reason"
                ],
                "properties": {
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              }
            ]
          },
          "canVerifyOfficial": {
            "type": "boolean"
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
